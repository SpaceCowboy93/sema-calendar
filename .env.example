# Copy this file to .env.local and replace every placeholder locally.
# Never commit a populated environment file.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace-with-your-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com
PUSH_SEND_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-a-long-random-secret
